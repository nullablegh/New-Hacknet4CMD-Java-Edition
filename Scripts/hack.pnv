clear
println [>] Target locked. Initiating PortHack override sequence...
play beep /m

let progress 0

# 模擬百分比進度條 (配合 printr 與 set 累加)
@ PROGRESS_LOOP
set progress + 20
printr [>>>] Cracking encryption keys... %progress%%
sleep 400

set progress + 20
printr [>>>] Cracking encryption keys... %progress%%
sleep 300

set progress + 20
printr [>>>] Cracking encryption keys... %progress%%
sleep 400

set progress + 20
printr [>>>] Cracking encryption keys... %progress%%
sleep 200

set progress + 20
printr [>>>] Cracking encryption keys... %progress%%
sleep 300

println 
println [+] Security daemon bypassed successfully!
println 

# 呼叫互動子腳本
call firewall.pnv

println 
println [***] ROOT PRIVILEGES GRANTED.
println System is ready for payload deployment.
play success /m